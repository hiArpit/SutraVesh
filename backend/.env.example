MONGODB_DB_NAME=sutravesh

# JWT Secret Key
JWT_SECRET_KEY=sutravesh-super-secret-key-hackathon-2026

WIKIPEDIA_USER_AGENT=WonderLensHackathon/1.0 (contact: team@sutravesh.local)
